<div>
  <div class="relative min-h-screen grid bg-black">
    <div class="flex min-h-screen flex-col md:flex-row items-stretch">
      <div
        class="hidden md:flex md:w-1/2 xl:w-3/5 flex-auto items-end justify-start overflow-hidden bg-cover bg-center p-10 text-white relative"
        style="background-image: url(/images/client-login.jpg);"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-black via-black/55 to-primary-900/70">
        </div>
        <div class="relative z-10 max-w-2xl space-y-8">
          <img src="/images/logo-white.svg" class="w-auto h-16 lg:h-20" />

          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-200">
              {gettext("Join 6,000+ speakers")}
            </p>
            <h1 class="text-4xl font-bold leading-tight text-white lg:text-6xl">
              {gettext("Make your presentations stand out with live audience interaction.")}
            </h1>
            <p class="max-w-xl text-lg leading-8 text-gray-100/90 lg:text-xl">
              {gettext(
                "Thousands of presenters already use F2XP to engage their audience in real time."
              )}
            </p>
          </div>
        </div>
      </div>

      <div class="flex w-full items-center justify-center p-8 md:w-1/2 md:p-10 lg:p-14 xl:w-2/5">
        <div class="w-full max-w-xl">
          <div class="space-y-6">
            <div class="text-center md:text-left">
              <a href="/" class="inline-flex items-center">
                <img src="/images/logo.svg" class="h-10 w-auto" />
              </a>

              <p class="mt-8 text-sm font-semibold uppercase tracking-[0.3em] text-primary-300">
                {gettext("Create account")}
              </p>
              <h2 class="mt-4 text-4xl font-bold text-white lg:text-5xl">
                {gettext("Create your account.")}
              </h2>
              <p class="mt-4 text-base leading-7 text-gray-300">
                {gettext(
                  "Upload a presentation, add live interactions, and share a code with your audience."
                )}
              </p>
            </div>

            <.form :let={f} for={@changeset} action={~p"/users/register"} class="space-y-6">
              <%= if @changeset.action do %>
                <ClaperWeb.Component.Alert.error
                  message={gettext("Oops, check that all fields are filled in correctly.")}
                  stick={true}
                />
              <% end %>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <ClaperWeb.Component.Input.text
                  form={f}
                  key={:first_name}
                  labelClass="text-white"
                  fieldClass="bg-gray-900/80 text-white border border-white/10"
                  name={gettext("First name")}
                  required="true"
                  maxlength="160"
                  autofocus="true"
                />

                <ClaperWeb.Component.Input.text
                  form={f}
                  key={:last_name}
                  labelClass="text-white"
                  fieldClass="bg-gray-900/80 text-white border border-white/10"
                  name={gettext("Last name")}
                  required="true"
                  maxlength="160"
                />
              </div>

              <ClaperWeb.Component.Input.email
                form={f}
                key={:email}
                labelClass="text-white"
                fieldClass="bg-gray-900/80 text-white border border-white/10"
                name={gettext("Email")}
                placeholder={gettext("you@example.com")}
                required="true"
              />

              <div class="space-y-3">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  <ClaperWeb.Component.Input.password
                    form={f}
                    key={:password}
                    labelClass="text-white"
                    fieldClass="bg-gray-900/80 text-white border border-white/10"
                    name={gettext("Password")}
                    placeholder={gettext("At least 6 characters")}
                    required="true"
                  />

                  <ClaperWeb.Component.Input.password
                    form={f}
                    key={:password_confirmation}
                    labelClass="text-white"
                    fieldClass="bg-gray-900/80 text-white border border-white/10"
                    name={gettext("Confirm password")}
                    placeholder={gettext("Repeat your password")}
                    required="true"
                  />
                </div>

                <p class="text-sm text-gray-400">
                  {gettext("Use at least 6 characters and enter the same password twice.")}
                </p>
              </div>

              <div class="pt-3">
                <button type="submit" class="btn btn-primary w-full">
                  {gettext("Create account")}
                </button>
              </div>
            </.form>

            <div class="space-y-4 border-t border-white/10 pt-6 text-center md:text-left">
              <p class="text-sm text-gray-300">
                {gettext("Already have an account?")}
                {" "}
                {link(gettext("Log in"),
                  to: ~p"/users/log_in",
                  class: "font-semibold text-primary-300 transition hover:text-primary-200"
                )}
              </p>

              <% terms_url = Application.get_env(:claper, :terms_url) %>
              <% privacy_url = Application.get_env(:claper, :privacy_url) %>
              <%= if terms_url && privacy_url do %>
                <p class="text-xs leading-6 text-gray-500">
                  {gettext("By creating an account, you agree to our")}
                  {" "}
                  {link(gettext("Terms of Service"),
                    to: terms_url,
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class:
                      "text-gray-300 underline decoration-gray-500 underline-offset-2 hover:text-white"
                  )}
                  {" "}
                  {gettext("and")}
                  {" "}
                  {link(gettext("Privacy Policy"),
                    to: privacy_url,
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class:
                      "text-gray-300 underline decoration-gray-500 underline-offset-2 hover:text-white"
                  )} .
                </p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

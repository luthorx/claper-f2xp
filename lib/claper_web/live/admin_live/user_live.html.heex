<%= case @live_action do %>
  <% :index -> %>
    <div>
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">{gettext("Users")}</h1>
        <.link navigate={~p"/admin/users/new"} class="btn btn-primary btn-sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            class="w-3 h-3"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M12 4v16m8-8H4"
            />
          </svg>
          {gettext("New user")}
        </.link>
      </div>

      <.form
        for={@form}
        class="flex flex-col sm:flex-row gap-3 sm:[&>div]:basis-[250px]"
        phx-change="filter-users"
      >
        <Flop.Phoenix.filter_fields :let={i} form={@form} fields={@fields}>
          <ClaperWeb.CoreComponents.input
            field={i.field}
            label={i.label}
            type={i.type}
            phx-debounce="300"
            {i.rest}
          />
        </Flop.Phoenix.filter_fields>
      </.form>

      <Flop.Phoenix.table
        items={@users}
        meta={@meta}
        path={~p"/admin/users"}
        opts={[
          container: true,
          container_attrs: [class: "card bg-base-100 shadow-md overflow-x-auto my-5"],
          no_results_content: ~H"""
          <p class="text-center py-10">{gettext("No users found")}</p>
          """,
          table_attrs: [class: "table table-zebra w-full"],
          symbol_asc: ~H"""
          <span aria-hidden="true"><ClaperWeb.Icons.arrow_up /></span>
          """,
          symbol_desc: ~H"""
          <span aria-hidden="true"><ClaperWeb.Icons.arrow_down /></span>
          """
        ]}
      >
        <:col :let={user} label={gettext("Email")} field={:email}>
          <.link navigate={~p"/admin/users/#{user}"} class="link font-bold">
            {user.email}
          </.link>
        </:col>
        <:col :let={user} label={gettext("First name")} field={:first_name}>
          {user.first_name || "—"}
        </:col>
        <:col :let={user} label={gettext("Last name")} field={:last_name}>
          {user.last_name || "—"}
        </:col>
        <:col :let={user} label={gettext("Role")} field={:role_id}>
          {if user.role, do: user.role.name, else: gettext("No role")}
        </:col>
        <:col :let={user} label={gettext("Status")} field={:confirmed_at}>
          <%= if user.confirmed_at do %>
            <span class="badge badge-success">{gettext("Confirmed")}</span>
          <% else %>
            <span class="badge badge-warning">{gettext("Unconfirmed")}</span>
          <% end %>
        </:col>
        <:col :let={user} label={gettext("Created")} field={:inserted_at}>
          {Calendar.strftime(user.inserted_at, "%Y-%m-%d %H:%M")}
        </:col>
        <:action :let={user} tbody_td_attrs={[class: "text-right"]}>
          <div class="flex justify-end gap-2">
            <.link
              navigate={~p"/admin/users/#{user}/edit"}
              class="btn btn-link btn-sm text-primary"
              title={gettext("Edit user")}
            >
              <span class="hero-pencil-square w-5 h-5" />
            </.link>
            <a
              href="#"
              phx-click="delete"
              phx-value-id={user.id}
              data-confirm={gettext("Are you sure you want to delete this user?")}
              class="btn btn-link btn-sm text-error"
              title={gettext("Delete user")}
            >
              <span class="hero-trash w-5 h-5" />
            </a>
          </div>
        </:action>
      </Flop.Phoenix.table>

      <div class="flex justify-end mt-4">
        <ClaperWeb.CoreComponents.pagination meta={@meta} path={~p"/admin/users"} />
      </div>
    </div>
  <% :show -> %>
    <div>
      <div>
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-3xl font-bold">{gettext("User details")}</h1>
          <div class="flex space-x-3">
            <.link navigate={~p"/admin/users"} class="btn btn-outline btn-sm">
              {gettext("Back to users")}
            </.link>
            <.link navigate={~p"/admin/users/#{@user}/edit"} class="btn btn-primary btn-sm">
              {gettext("Edit")}
            </.link>
          </div>
        </div>
      </div>

      <div class="mt-6">
        <.detail_card>
          <.detail_row label={gettext("First name")}>
            {@user.first_name || "—"}
          </.detail_row>
          <.detail_row label={gettext("Last name")}>
            {@user.last_name || "—"}
          </.detail_row>
          <.detail_row label={gettext("Email")}>
            <a href={"mailto:#{@user.email}"} class="link link-primary">{@user.email}</a>
          </.detail_row>
          <.detail_row label={gettext("Role")}>
            {if @user.role, do: @user.role.name, else: gettext("No role")}
          </.detail_row>
          <.detail_row label={gettext("Status")}>
            <%= if @user.confirmed_at do %>
              <span class="badge badge-success">{gettext("Confirmed")}</span>
            <% else %>
              <span class="badge badge-warning">{gettext("Unconfirmed")}</span>
            <% end %>
          </.detail_row>
          <.detail_row label={gettext("Created At")}>
            {format_admin_timestamp(@user.inserted_at)}
          </.detail_row>
          <.detail_row label={gettext("Last Updated")}>
            {format_admin_timestamp(@user.updated_at)}
          </.detail_row>
          <.detail_row label={gettext("Confirmed At")} show={!is_nil(@user.confirmed_at)}>
            {format_admin_timestamp(@user.confirmed_at)}
          </.detail_row>
        </.detail_card>
      </div>

      <div class="mt-8">
        <h2 class="text-2xl font-bold mb-4">{gettext("Audit Logs")}</h2>

        <Flop.Phoenix.table
          items={@audit_logs}
          meta={@audit_meta}
          path={~p"/admin/users/#{@user}"}
          opts={[
            container: true,
            container_attrs: [class: "card bg-base-100 shadow-md overflow-x-auto"],
            no_results_content: ~H"""
            <p class="text-center py-10">{gettext("No audit logs for this user.")}</p>
            """,
            table_attrs: [class: "table table-zebra w-full"],
            symbol_asc: ~H"""
            <span aria-hidden="true"><ClaperWeb.Icons.arrow_up /></span>
            """,
            symbol_desc: ~H"""
            <span aria-hidden="true"><ClaperWeb.Icons.arrow_down /></span>
            """
          ]}
        >
          <:col :let={log} label={gettext("ID")} field={:id}>
            <.link navigate={~p"/admin/audit_logs/#{log}"} class="link font-bold">
              {log.id}
            </.link>
          </:col>
          <:col :let={log} label={gettext("Action")} field={:action}>
            <span class="badge badge-outline">{log.action}</span>
          </:col>
          <:col :let={log} label={gettext("Timestamp")} field={:inserted_at}>
            {format_admin_timestamp(log.inserted_at)}
          </:col>
          <:col
            :let={log}
            label={gettext("Metadata")}
            tbody_td_attrs={[class: "max-w-xs truncate text-sm text-base-content/70"]}
          >
            {format_audit_metadata(log.metadata)}
          </:col>
        </Flop.Phoenix.table>

        <div class="flex justify-end mt-4">
          <ClaperWeb.CoreComponents.pagination
            meta={@audit_meta}
            path={~p"/admin/users/#{@user}"}
          />
        </div>
      </div>
    </div>
  <% :new -> %>
    <div>
      <div>
        <div class="flex justify-between items-center">
          <h1 class="text-3xl font-bold">{gettext("New user")}</h1>
        </div>
      </div>

      <div class="mt-6">
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <.live_component
              module={ClaperWeb.AdminLive.UserLive.FormComponent}
              id="user-form"
              title={gettext("New user")}
              action={:new}
              user={@user}
              navigate={~p"/admin/users"}
            />
          </div>
        </div>
      </div>
    </div>
  <% :edit -> %>
    <div>
      <div>
        <div class="flex justify-between items-center">
          <h1 class="text-3xl font-bold">{gettext("Edit user")}</h1>
        </div>
      </div>

      <div class="mt-6">
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <.live_component
              module={ClaperWeb.AdminLive.UserLive.FormComponent}
              id={"user-form-#{@user.id}"}
              title={gettext("Edit user")}
              action={:edit}
              user={@user}
              navigate={~p"/admin/users"}
            />
          </div>
        </div>
      </div>
    </div>
<% end %>
